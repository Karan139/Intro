generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum GenerationMode {
  TEXT_TO_VIDEO
  IMAGE_TO_VIDEO
  FRAMES_TO_VIDEO
}

enum JobStatus {
  QUEUED
  RUNNING
  PROCESSING
  UPLOADING
  DONE
  FAILED
  CANCELED
}

enum AssetType {
  IMAGE
  FRAME
  VIDEO
  THUMBNAIL
}

enum LedgerEntryType {
  CREDIT_GRANT
  CREDIT_CONSUME
  ADJUSTMENT
}

enum PlanTier {
  FREE
  CREATOR
  STUDIO
  ENTERPRISE
}

model User {
  id              String             @id @default(cuid())
  email           String             @unique
  name            String?
  image           String?
  role            Role               @default(USER)
  creditsBalance  Int                @default(0)
  planTier        PlanTier           @default(FREE)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  projects        Project[]
  generations     Generation[]
  ledgerEntries   BillingLedger[]
}

model Project {
  id                String        @id @default(cuid())
  userId            String
  title             String
  description       String?
  autosaveSettings  Json?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  generations       Generation[]
}

model Generation {
  id                    String         @id @default(cuid())
  userId                String
  projectId             String?
  mode                  GenerationMode
  status                JobStatus      @default(QUEUED)
  prompt                String
  negativePrompt        String?
  seed                  Int?
  lockSeed              Boolean        @default(false)
  durationSeconds       Int
  aspectRatio           String
  resolution            String
  frameRate             Int?
  qualityTier           String
  outputCodec           String         @default("h264")
  format                String         @default("mp4")
  model                 String
  provider              String
  settings              Json
  storyboard            Json?
  errorMessage          String?
  previewUrl            String?
  outputUrl             String?
  costCredits           Int            @default(0)
  startedAt             DateTime?
  completedAt           DateTime?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  user                  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  project               Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  assets                Asset[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model Asset {
  id             String      @id @default(cuid())
  generationId   String?
  userId         String
  type           AssetType
  url            String
  storageKey     String
  mimeType       String?
  width          Int?
  height         Int?
  durationSec    Float?
  orderIndex     Int?
  metadata       Json?
  createdAt      DateTime    @default(now())
  generation     Generation? @relation(fields: [generationId], references: [id], onDelete: SetNull)
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([generationId, type])
}

model BillingLedger {
  id             String          @id @default(cuid())
  userId         String
  entryType      LedgerEntryType
  deltaCredits   Int
  balanceAfter   Int
  referenceId    String?
  metadata       Json?
  createdAt      DateTime        @default(now())
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model AdminLog {
  id            String   @id @default(cuid())
  generationId  String?
  level         String
  message       String
  metadata      Json?
  createdAt     DateTime @default(now())

  @@index([createdAt])
}
